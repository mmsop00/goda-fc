# ═══════════════════════════════════════
# GODA FC — Environment Variables
# Copy sang .env (local) hoặc khai báo trên Vercel Project Settings
# ═══════════════════════════════════════

# ── Neon PostgreSQL ─────────────────────
# DATABASE_URL: chuỗi POOLED (host có "-pooler") — dùng cho ứng dụng chạy trên Vercel
# DIRECT_URL:   chuỗi DIRECT (host không có "-pooler") — dùng cho Prisma CLI (db push/migrate)
# Cả hai lấy từ Neon Console → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth v5 ─────────────────────────
# Sinh bằng: npx auth secret (hoặc openssl rand -base64 32)
AUTH_SECRET=""

# ── Seed (tạo tài khoản admin ban đầu) ──
ADMIN_EMAIL="admin@goda-fc.vn"
ADMIN_PASSWORD=""
