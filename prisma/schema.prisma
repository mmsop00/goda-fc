// ═══════════════════════════════════════
// GODA FC — Prisma Schema (PostgreSQL)
// ═══════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════
// Auth — NextAuth.js v5
// ═══════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("editor") // admin | editor
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════
// Club Data
// ═══════════════════════════════════════

model Member {
  id        String   @id @default(cuid())
  name      String
  nickname  String
  position  String   // Thủ môn | Hậu vệ | Tiền vệ | Tiền đạo
  number    Int
  avatarUrl String   @default("")
  matches   Int      @default(0)
  goals     Int      @default(0)
  assists   Int      @default(0)
  mvp       Int      @default(0)
  birthday  String?  // DD/MM/YYYY (dữ liệu seed cũ chỉ có DD/MM)
  joinYear  Int?
  status    String   @default("Đang thi đấu")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Hồ sơ cầu thủ — thành viên tự sửa, ghi đè lên thẻ cầu thủ công khai ───
  joinDate           String?   // DD/MM/YYYY hoặc chỉ năm YYYY
  preferredFoot      String?   // phai | trai | hai_chan
  hometown           String?
  profileUpdatedAt   DateTime? // có giá trị = đã tự sửa hồ sơ → dùng thay dữ liệu mặc định

  // ─── Cổng tài chính (đăng nhập bằng số điện thoại) ───
  // Không @unique: db push chạy non-interactive trên Vercel sẽ dừng vì cảnh
  // báo "data loss" khi thêm unique; script đồng bộ tự kiểm tra trùng số.
  phone              String?   // đăng nhập cổng thành viên
  passwordHash       String?
  mustChangePassword Boolean   @default(false) // chỉ true cho chủ tịch lần đầu
  financeRole        String    @default("member") // member | chairman

  billsCreated   Bill[]          @relation("BillsCreated")
  fundEntries    FundEntry[]     @relation("FundEntriesCreated")
  credits        CreditEntry[]   @relation("MemberCredits")
  paymentItems   PaymentItem[]   @relation("MemberPaymentItems")
  paymentIntents PaymentIntent[] @relation("MemberPaymentIntents")
}

// ═══════════════════════════════════════
// Club Finance — Cổng thành viên & chủ tịch
// ═══════════════════════════════════════

model Bill {
  id                String   @id @default(cuid())
  title             String
  kind              String   @default("khac") // quy_thang | khac
  period            String?  // YYYY-MM — tháng áp dụng (báo cáo theo kỳ); quỹ tháng dùng để chặn tạo trùng
  amountPerMember   Int      // số tiền mặc định; từng người có thể khác (PaymentItem.amount)
  dueDate           String?  // DD/MM/YYYY
  createdByMemberId String
  createdAt         DateTime @default(now())

  createdBy Member        @relation("BillsCreated", fields: [createdByMemberId], references: [id])
  items     PaymentItem[]
}

/// Sổ số dư của từng thành viên — chỉ phát sinh khi nộp thừa / nộp thiếu.
/// Số dư = tổng `amount`. Mỗi lần duyệt: +tiền thực nhận ("nop"), −từng khoản được
/// trừ trọn ("tru"); nộp đúng thì 2 dòng triệt tiêu, số dư không đổi.
model CreditEntry {
  id                String   @id @default(cuid())
  memberId          String
  kind              String   // nop | tru | dieu_chinh
  amount            Int      // + tăng số dư, − giảm số dư
  paymentIntentId   String?  // lần chuyển khoản (kind = nop)
  paymentItemId     String?  // khoản được trừ (kind = tru)
  note              String?
  createdByMemberId String?
  createdAt         DateTime @default(now())

  member Member @relation("MemberCredits", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// Sổ quỹ ghi tay của chủ tịch: khoản chi, và khoản thu không qua đóng quỹ
/// thành viên (tài trợ, số dư chuyển sang...). Tiền thành viên đóng quỹ nằm ở PaymentItem.
model FundEntry {
  id                String   @id @default(cuid())
  direction         String   // chi | thu
  category          String   // xem src/lib/finance/categories.ts
  title             String
  amount            Int
  date              String   // YYYY-MM-DD — ngày tiền thực vào/ra (báo cáo theo dòng tiền)
  period            String?  // YYYY-MM — tháng áp dụng (báo cáo theo kỳ); trống = tháng của `date`
  note              String?
  createdByMemberId String
  createdAt         DateTime @default(now())

  createdBy Member @relation("FundEntriesCreated", fields: [createdByMemberId], references: [id])
}

model PaymentItem {
  id                  String    @id @default(cuid())
  billId              String
  memberId            String
  amount              Int       // snapshot lúc tạo, không đổi theo Bill sau này
  status              String    @default("chua_dong") // chua_dong | cho_duyet | da_dong
  paidIntentId        String?
  confirmedAt         DateTime?
  confirmedByMemberId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  member     Member         @relation("MemberPaymentItems", fields: [memberId], references: [id], onDelete: Cascade)
  paidIntent PaymentIntent? @relation("ClaimedItems", fields: [paidIntentId], references: [id])

  intentLinks PaymentIntentItem[]

  @@unique([billId, memberId])
}

model PaymentIntent {
  id                  String    @id @default(cuid())
  memberId            String
  code                String    @unique // vd "GODA7K3PQ2" — nhúng vào nội dung CK
  totalAmount         Int
  status              String    @default("cho_bien_lai") // cho_bien_lai | cho_duyet | da_xac_nhan | tu_choi | da_huy (khoản bị chủ tịch sửa)
  ocrHint             String?   // likely_match | needs_review
  ocrRawText          String?
  confirmedAt         DateTime?
  confirmedByMemberId String?
  rejectionNote       String?
  receivedAmount      Int?      // số tiền chủ tịch thực nhận (có thể thừa/thiếu so với totalAmount)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  member   Member              @relation("MemberPaymentIntents", fields: [memberId], references: [id], onDelete: Cascade)
  items    PaymentIntentItem[]
  claimed  PaymentItem[]       @relation("ClaimedItems")
  receipts PaymentReceipt[]
}

// Bảng nối: 1 mã QR/intent có thể gộp nhiều khoản (PaymentItem) cùng lúc.
model PaymentIntentItem {
  id              String @id @default(cuid())
  paymentIntentId String
  paymentItemId   String

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  paymentItem   PaymentItem   @relation(fields: [paymentItemId], references: [id], onDelete: Cascade)

  @@unique([paymentIntentId, paymentItemId])
}

model PaymentReceipt {
  id              String   @id @default(cuid())
  paymentIntentId String
  imageData       Bytes
  mimeType        String   @default("image/jpeg")
  uploadedAt      DateTime @default(now())
  expiresAt       DateTime // uploadedAt + 90 ngày — cron + lazy-read sẽ xoá khi quá hạn

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
}

model Match {
  id             String   @id @default(cuid())
  season         String
  date           String   // DD/MM/YYYY
  time           String   @default("16:00")
  venue          String
  type           String   @default("Giao hữu") // Giao hữu | Giải đấu | Cúp
  tournament     String?
  isHome         Boolean  @default(false)
  opponent       String
  opponentScore  Int      @default(0)
  godaScore      Int      @default(0)
  godaLineup     Json     @default("[]")
  opponentLineup Json     @default("[]")
  mvp            String?
  imageUrl       String   @default("")
  videoUrl       String?
  googleMapsUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goals MatchGoal[]
  cards MatchCard[]
}

model MatchGoal {
  id      String @id @default(cuid())
  matchId String
  player  String
  minute  Int
  assist  String?
  side    String // GODA | opponent

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchCard {
  id      String @id @default(cuid())
  matchId String
  player  String
  minute  Int
  type    String // yellow | red
  side    String // GODA | opponent

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model NewsItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String
  content      String
  date         String   // DD/MM/YYYY
  category     String   // Tin CLB | Trận đấu | Sinh nhật | Giải đấu | Kỷ niệm | Thông báo
  author       String   @default("Ban truyền thông GODA FC")
  thumbnailUrl String   @default("")
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HallOfFameEntry {
  id          String   @id @default(cuid())
  name        String
  categories  String[]
  title       String
  year        String
  description String
  avatarUrl   String   @default("")
  highlight   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donor {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  month     String?
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  category     String   // Trận đấu | Sự kiện | Sinh hoạt | Kỷ niệm
  title        String
  date         String
  thumbnailUrl String
  fullUrl      String
  createdAt    DateTime @default(now())
}

// ═══════════════════════════════════════
// Ủng hộ công khai từ trang chủ (không cần đăng nhập)
// ═══════════════════════════════════════

/// 1 lượt ủng hộ: người ủng hộ tự khai số tiền → QR → ảnh bill → chủ tịch xác nhận
/// số tiền thực nhận → hiện trên trang chủ và cộng vào quỹ đội.
model Donation {
  id                  String    @id @default(cuid())
  code                String    @unique // nội dung chuyển khoản, vd "GODA7K3PQ2"
  tokenHash           String    // sha256 của mã bí mật trả cho trình duyệt người ủng hộ — chỉ họ mới gửi được ảnh bill
  donorName           String
  anonymous           Boolean   @default(false)
  showAmount          Boolean   @default(true) // cho phép hiện số tiền trên trang chủ
  message             String?
  amount              Int       // số tiền người ủng hộ khai
  receivedAmount      Int?      // số chủ tịch thực nhận — số được cộng vào quỹ
  status              String    @default("cho_bien_lai") // cho_bien_lai | cho_duyet | da_xac_nhan | tu_choi
  ocrHint             String?
  ocrRawText          String?
  ipHash              String?   // chống spam: giới hạn số lượt tạo theo địa chỉ mạng
  confirmedAt         DateTime?
  confirmedByMemberId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  receipts DonationReceipt[]

  @@index([status])
}

model DonationReceipt {
  id         String   @id @default(cuid())
  donationId String
  imageData  Bytes
  mimeType   String   @default("image/jpeg")
  uploadedAt DateTime @default(now())
  expiresAt  DateTime // uploadedAt + 90 ngày

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

/// Cài đặt quỹ CLB (1 dòng duy nhất, id = "default")
model FundSetting {
  id                String   @id @default("default")
  autoMonthly       Boolean  @default(false) // tự tạo "Quỹ tháng MM/YYYY" lúc 00:00 ngày 1 hằng tháng
  monthlyAmount     Int      @default(200000) // số tiền mỗi người
  dueDay            Int?     // hạn đóng: ngày mấy trong tháng (trống = không đặt hạn)
  updatedByMemberId String?
  updatedAt         DateTime @updatedAt
}
